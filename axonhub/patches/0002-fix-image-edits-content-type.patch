+// TestBuildImageEditRequest_JSONBody forwards the raw JSON body verbatim (with
+// the model patched) when the inbound request used application/json, instead of
+// rebuilding a multipart payload.
+func TestBuildImageEditRequest_JSONBody(t *testing.T) {
+	tr, err := NewOutboundTransformer("https://api.openai.com/v1", "test-key")
+	require.NoError(t, err)
+
+	ot := tr.(*OutboundTransformer)
+
+	rawBody := []byte(`{"model":"sensenova-u1.5-lite","prompt":"edit it","image":"https://example.com/a.png","size":"1024x1024"}`)
+
+	inboundHeaders := make(http.Header)
+	inboundHeaders.Set("Content-Type", "application/json")
+
+	req := &llm.Request{
+		Model:     "mapped-sensenova-u1.5-lite",
+		APIFormat: llm.APIFormatOpenAIImageEdit,
+		Image: &llm.ImageRequest{
+			Prompt: "edit it",
+			Size:   "1024x1024",
+		},
+		RawRequest: &httpclient.Request{
+			Headers: inboundHeaders,
+			Body:    rawBody,
+		},
+	}
+
+	httpReq, err := ot.buildImageEditRequest(req, "test-key")
+	require.NoError(t, err)
+	require.NotNil(t, httpReq)
+
+	assert.Equal(t, "https://api.openai.com/v1/images/edits", httpReq.URL)
+	assert.Equal(t, "application/json", httpReq.ContentType)
+	assert.Contains(t, httpReq.Headers.Get("Content-Type"), "application/json")
+
+	// The raw body is forwarded with the mapped model patched in.
+	assert.JSONEq(t, `{"model":"mapped-sensenova-u1.5-lite","prompt":"edit it","image":"https://example.com/a.png","size":"1024x1024"}`, string(httpReq.Body))
+}
