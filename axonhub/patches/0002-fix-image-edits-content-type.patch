+// TestApplyPassThroughBody_ImageEditJSON applies the raw JSON body for an
+// application/json image edit request when pass-through is enabled.
+func TestApplyPassThroughBody_ImageEditJSON(t *testing.T) {
+	ctx := context.Background()
+
+	channel := &biz.Channel{
+		Channel: &ent.Channel{
+			ID:   1,
+			Name: "pass-through-image-edit-json",
+			Settings: &objects.ChannelSettings{
+				PassThroughBody: lo.ToPtr(true),
+			},
+		},
+	}
+
+	inboundBody := []byte(`{"model":"sensenova-u1.5-lite","prompt":"edit it","image":"https://example.com/a.png"}`)
