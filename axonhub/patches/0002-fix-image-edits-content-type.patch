+// imageEditJSONRequest models an application/json body for the images/edits
+// endpoint. Some providers (e.g. SenseNova) accept JSON instead of multipart
+// for image editing; when the inbound request uses application/json the raw
+// body is forwarded verbatim (see transformEditJSONRequest) rather than
+// rebuilt as multipart.
+type imageEditJSONRequest struct {
+	Prompt            string          `json:"prompt"`
+	Model             string          `json:"model"`
+	N                 *int64          `json:"n,omitempty"`
+	Size              string          `json:"size,omitempty"`
+	Quality           string          `json:"quality,omitempty"`
+	ResponseFormat    string          `json:"response_format,omitempty"`
+	User              string          `json:"user,omitempty"`
+	Background        string          `json:"background,omitempty"`
+	OutputFormat      string          `json:"output_format,omitempty"`
+	OutputCompression *int64          `json:"output_compression,omitempty"`
+	InputFidelity     string          `json:"input_fidelity,omitempty"`
+	PartialImages     *int64          `json:"partial_images,omitempty"`
+	Image             json.RawMessage `json:"image,omitempty"`
+	Mask              json.RawMessage `json:"mask,omitempty"`
+}
+
+// transformEditJSONRequest handles application/json image edit requests. The
+// raw JSON body is preserved on RawRequest so the outbound transformer and the
+// pass-through middleware can forward it unchanged to providers that expect
+// JSON. Only the scalar fields needed for routing, logging and model mapping
+// are parsed; image/mask payloads are not decoded to bytes.
+func (t *ImageInboundTransformer) transformEditJSONRequest(httpReq *httpclient.Request) (*llm.Request, error) {
+	var editReq imageEditJSONRequest
+	if err := json.Unmarshal(httpReq.Body, &editReq); err != nil {
+		return nil, fmt.Errorf("%w: failed to decode image edit request: %w", transformer.ErrInvalidRequest, err)
+	}
+
+	prompt := strings.TrimSpace(editReq.Prompt)
+	if prompt == "" {
+		return nil, fmt.Errorf("%w: prompt is required for image edits", transformer.ErrInvalidRequest)
+	}
+
+	model := strings.TrimSpace(editReq.Model)
+	if model == "" {
+		model = "dall-e-2"
+	}
+
+	// The raw body is already JSON; keep it as the JSONBody for logging.
+	httpReq.JSONBody = append([]byte(nil), httpReq.Body...)
+
+	imageReq := &llm.ImageRequest{
+		Prompt:            prompt,
+		N:                 editReq.N,
+		Size:              editReq.Size,
+		Quality:           editReq.Quality,
+		ResponseFormat:    editReq.ResponseFormat,
+		User:              editReq.User,
+		Background:        editReq.Background,
+		OutputFormat:      editReq.OutputFormat,
+		OutputCompression: editReq.OutputCompression,
+		InputFidelity:     editReq.InputFidelity,
+		PartialImages:     editReq.PartialImages,
+	}
+
+	llmReq := &llm.Request{
+		Model:       model,
+		Modalities:  []string{"image"},
+		Stream:      lo.ToPtr(false),
+		RawRequest:  httpReq,
+		RequestType: llm.RequestTypeImage,
+		APIFormat:   t.apiFormat,
+		Image:       imageReq,
+	}
+
+	return llmReq, nil
+}
+
