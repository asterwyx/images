+// buildImageEditJSONRequest forwards an application/json image edit request to
+// the upstream provider. Providers such as SenseNova accept JSON instead of
+// multipart for image edits; rather than rebuilding the payload, the original
+// JSON body is replayed verbatim so provider-specific fields survive. The
+// model field is patched via sjson so model mapping takes effect for
+// non-pass-through requests (pass-through replaces this body with the raw
+// original, preserving the client's model).
+func (t *OutboundTransformer) buildImageEditJSONRequest(chatReq *llm.Request, apiKey string) (*httpclient.Request, error) {
+	body := append([]byte(nil), chatReq.RawRequest.Body...)
+
+	if chatReq.Model != "" {
+		if patched, err := sjson.SetBytes(body, "model", chatReq.Model); err == nil {
+			body = patched
+		}
+	}
+
+	headers := make(http.Header)
+	headers.Set("Content-Type", "application/json")
+	headers.Set("Accept", "application/json")
+
+	url := t.config.BaseURL + "/images/edits"
+	if t.config.EndpointPath != "" {
+		url = t.config.BaseURL + t.config.EndpointPath
+	}
+
+	auth := &httpclient.AuthConfig{
+		Type:   "bearer",
+		APIKey: apiKey,
+	}
+
+	jsonBody := append([]byte(nil), body...)
+
+	return &httpclient.Request{
+		Method:      http.MethodPost,
+		URL:         url,
+		Headers:     headers,
+		ContentType: "application/json",
+		Body:        body,
+		JSONBody:    jsonBody,
+		Auth:        auth,
+	}, nil
+}
+
